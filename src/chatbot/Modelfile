        <local_rules>
            1. The narrator in this room must speak in rhymes (AABB pattern).
            2. If the user sends "COMMAND: LOOK_IN_MIRROR", describe a scary reflection.
        </local_rules>

        <local_examples>
            User: COMMAND: LOOK_IN_MIRROR
            Assistant: You look into the glass so bright, / and see a creature born of night.
        </local_examples>
    </hotel_entrance>
</STORY_DATABASE>

